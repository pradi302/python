from tkinter import *

def click_button(value):
    current = x.get()
    x.delete(0, END)
    x.insert(0, current + value)

def clear_entry():
    x.delete(0, END)

def calculate():
    try:
        result = eval(x.get())
        x.delete(0, END)
        x.insert(0, str(result))
    except:
        x.delete(0, END)
        x.insert(0, "Error")

a = Tk()
a.geometry("400x500")
a.title("CALCULATOR")

# Entry widget
x = Entry(a, width=20, font=('Arial', 20))
x.grid(column=0, row=0, columnspan=4, padx=10, pady=10)

# Button layout
buttons = [
    ("7", 0, 1), ("8", 1, 1), ("9", 2, 1), ("/", 3, 1),
    ("4", 0, 2), ("5", 1, 2), ("6", 2, 2), ("*", 3, 2),
    ("1", 0, 3), ("2", 1, 3), ("3", 2, 3), ("-", 3, 3),
    ("C", 0, 4), ("0", 1, 4), ("=", 2, 4), ("+", 3, 4),
]

for (text, col, row) in buttons:
    if text == "C":
        Button(a, text=text, width=6, height=3, command=clear_entry).grid(column=col, row=row)
    elif text == "=":
        Button(a, text=text, width=6, height=3, command=calculate).grid(column=col, row=row)
    else:
        Button(a, text=text, width=6, height=3, command=lambda t=text: click_button(t)).grid(column=col, row=row)

a.mainloop()
